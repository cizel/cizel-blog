{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "installCommand": "",
    "buildCommand": "bash deploy.sh",
    "outputDirectory": "public",
    "build": {
        "env": {
            "HUGO_VERSION": "0.168.0"
        }
    },
    "redirects": [
        {
            "source": "/post/:path(.*)",
            "destination": "/posts/:path",
            "statusCode": 301
        },
        {
            "source": "/post",
            "destination": "/posts",
            "statusCode": 301
        }
    ]
}
